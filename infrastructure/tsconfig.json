{
    "compilerOptions": {
        "target": "ES2022",
        "module": "node16",
        "moduleResolution": "node16",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node"
        ],
        "outDir": "cdk.out",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "bin/**/*.ts",
        "lib/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "cdk.out"
    ]
}